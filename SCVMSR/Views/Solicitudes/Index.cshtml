@model IEnumerable<SCVMSR.Models.Solicitudes>
@using SCVMSR.Views.Helpers

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .estado-rechazada {
        color: red !important;
        font-weight: bold !important;
    }

    .estado-aceptada {
        color: green !important;
        font-weight: bold !important;
    }

    .estado-pendiente {
        color: gray !important;
        font-weight: bold !important;
    }
</style>

<h2>Solicitudes</h2>

<p>
    @Html.ActionLink("Crear Nueva Solicitud", "Create", new { }, new { @class = "btn btn-primary" })
</p>
<table class="table datatable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Empleados.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Motivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaSolicitud)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            <tr>
                <td>
                    @string.Concat(item.Empleados.Nombre, " ", item.Empleados.SegundoNombre, " ", item.Empleados.PrimerApellido)
                </td>
                <td>
                    @Html.MotivoTexto(item.Motivo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaInicio)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaFin)
                </td>
                <td class="@(item.Estado == "Rechazada" ? "estado-rechazada" : item.Estado == "Aceptada" ? "estado-aceptada" : "estado-pendiente")">
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaSolicitud)
                </td>

                <td>
                    @if (item.Estado != "Aceptada" && item.Estado != "Rechazada")
                    {
                        <text>@Html.ActionLink("Editar", "Edit", new { id = item.IdSolicitud }, new { @class = "btn btn-warning" })</text>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
