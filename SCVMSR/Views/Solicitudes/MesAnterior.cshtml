
@{
    ViewBag.Title = "Mes Anterior";
    Layout = "~/Views/Shared/_Layout.cshtml";

    System.Data.DataTable solicitudesMesAnt = ViewBag.SolicitudesMesAnt as System.Data.DataTable;
}

<div class="container">
    <h2>Resumen de Solicitudes del Mes Anterior</h2>
    @Html.ActionLink("Generar PDF del resumen del Mes Anterior", "ImprimirResumenMesAnteriorPDF", "Solicitudes", new { }, new { @class = "btn btn-primary" })

    @if (solicitudesMesAnt != null && solicitudesMesAnt.Rows.Count > 0)
    {
        <table class="table table-striped datatable">
            <thead>
                <tr>
                    <th class="text-center">Nombre</th>
                    <th class="text-center">Motivo</th>
                    <th class="text-center">Fecha de Inicio</th>
                    <th class="text-center">Fecha de Finalización</th>
                    <th class="text-center">Total de Días</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Fecha de Solicitud</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in solicitudesMesAnt.Rows)
                {
                <tr>
                    <td>@row["NombreCompleto"]</td>
                    <td class="text-center">@row["Motivo"]</td>
                    <td class="text-center">@(((DateTime)row["FechaInicio"]).ToString("dd/MM/yyyy"))</td>
                    <td class="text-center">@(((DateTime)row["FechaFin"]).ToString("dd/MM/yyyy"))</td>
                    <td class="text-center">@row["DiasSolicitados"]</td>
                    <td class="text-center">@row["Estado"]</td>
                    <td class="text-center">@(((DateTime)row["FechaSolicitud"]).ToString("dd/MM/yyyy"))</td>
                </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <hr />
        <p>No se encontraron solicitudes del mes anterior</p>
    }
</div>