

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-body pb-4">
                    <h5 class="card-title">Bienvenido al Control de Vacaciones</h5>
                    <p style="font-size: 15px">Seleccione desde los botones a continuación o la izquierda de su pantalla</p>
                    <hr />
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <button class="btn btn-primary mb-2" href="@Url.Action("MesAnterior", "Solicitudes")">Solicitudes del mes anterior</button>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-primary mb-2" href="@Url.Action("Index", "Empleados")">Resumen de los Funcionarios</button>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-primary mb-2" href="@Url.Action("Index", "Solicitudes")">Resumen de las Solicitudes</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>