
@{
    ViewBag.Title = "Empleados Activos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    System.Data.DataTable empleadosActivos = ViewBag.EmpleadosActivos as System.Data.DataTable;
}

<div class="container">
    <h2>Empleados Activos</h2>
    @if (empleadosActivos != null && empleadosActivos.Rows.Count > 0)
    {
        <table class="table table-striped datatable">
            <thead>
                <tr>
                    <th class="text-center">Nombre Completo</th>
                    <th class="text-center">Puesto</th>
                    <th class="text-center">Fecha de Contratación</th>
                    <th class="text-center">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in empleadosActivos.Rows)
                {
                <tr>
                    <td class="text-center">@row["NombreCompleto"]</td>
                    <td class="text-center">@row["Puesto"]</td>
                    <td class="text-center">@Convert.ToDateTime(row["FechaContratacion"]).ToString("yyyy-MM-dd")</td>
                    <td class="text-center">@row["Saldo"]</td>
                    <td>
                </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No se encontraron empleados activos</p>
    }
</div>

@section scripts {
    <script>$(document).ready(function() {
            $('.datatable').DataTable();
        });</script>
}