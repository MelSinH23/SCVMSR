
@{
    ViewBag.Title = "Empleados Inactivos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    System.Data.DataTable empleadosInactivos = ViewBag.EmpleadosInactivos as System.Data.DataTable;
}

<div class="container">
    <h2>Empleados Inactivos</h2>
    @if (empleadosInactivos != null && empleadosInactivos.Rows.Count > 0)
    {
        <table class="table table-striped datatable">
            <thead>
                <tr>
                    <th class="text-center">Nombre Completo</th>
                    <th class="text-center">Puesto</th>
                    <th class="text-center">Fecha de Contratación</th>
                    <th class="text-center">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in empleadosInactivos.Rows)
                {
                    <tr>
                        <td class="text-center">@row["NombreCompleto"]</td>
                        <td class="text-center">@row["Puesto"]</td>
                        <td class="text-center">@Convert.ToDateTime(row["FechaContratacion"]).ToString("yyyy-MM-dd")</td>
                        <td class="text-center">@row["Saldo"]</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No se encontraron empleados inactivos</p>
    }
</div>
